// CamiPrints schema — Supabase Postgres via Prisma.
// The catalog mirrors src/types/catalog.ts; the static seed repository and
// this schema stay in lockstep so DATA_SOURCE can switch without UI changes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Difficulty {
  easy
  medium
  detailed
}

enum AgeRange {
  ages_3_5  @map("3-5")
  ages_6_8  @map("6-8")
  ages_9up  @map("9-plus")
}

enum DetailLevel {
  large_spaces @map("large-spaces")
  balanced
  fine_detail  @map("fine-detail")
}

enum Orientation {
  portrait
  landscape
}

enum JobStatus {
  idle
  uploading
  queued
  processing
  ready
  failed
}

model Category {
  id           String         @id @default(uuid())
  slug         String         @unique
  name         String
  /// Tint token key for the tile thumbnail; null = neutral.
  tint         String?
  thumbnailUrl String?
  featured     Boolean        @default(false)
  order        Int
  pages        ColoringPage[]

  @@map("categories")
}

model ColoringPage {
  id           String      @id @default(uuid())
  slug         String
  title        String
  description  String
  category     Category    @relation(fields: [categoryId], references: [id])
  categoryId   String
  difficulty   Difficulty
  ageRange     AgeRange
  detailLevel  DetailLevel
  orientation  Orientation @default(portrait)
  thumbnailUrl String?
  previewUrl   String?
  pngUrl       String?
  pdfUrl       String?
  isEasyPick   Boolean     @default(false)
  publishedAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  tags         PageTag[]
  favorites    Favorite[]

  @@unique([categoryId, slug])
  @@index([publishedAt])
  @@map("coloring_pages")
}

model Tag {
  id    String    @id @default(uuid())
  slug  String    @unique
  name  String
  pages PageTag[]

  @@map("tags")
}

model PageTag {
  page   ColoringPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  pageId String
  tag    Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId  String

  @@id([pageId, tagId])
  @@map("page_tags")
}

/// userId references Supabase auth.users; no local user table.
model Favorite {
  userId    String
  page      ColoringPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  pageId    String
  createdAt DateTime     @default(now())

  @@id([userId, pageId])
  @@map("favorites")
}

/// A saved converter result (opt-in, account only). The source photo is NOT
/// retained — only the generated line art.
model Creation {
  id        String   @id @default(uuid())
  userId    String
  resultUrl String
  settings  Json
  createdAt DateTime @default(now())
  expiresAt DateTime?

  @@index([userId])
  @@map("creations")
}

/// Conversion job lifecycle. photoPath points into a PRIVATE storage bucket;
/// uploads are deleted after the session (expiresAt) and never published.
model ConversionJob {
  id         String    @id @default(uuid())
  sessionId  String
  userId     String?
  status     JobStatus @default(idle)
  settings   Json
  error      String?
  photoPath  String?
  resultPath String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  expiresAt  DateTime

  @@index([sessionId])
  @@index([expiresAt])
  @@map("conversion_jobs")
}

/// Every admin action that reveals a user photo is recorded here — this is a
/// product requirement, not an optimisation.
model AdminAuditLog {
  id        String   @id @default(uuid())
  adminId   String
  action    String
  jobId     String?
  createdAt DateTime @default(now())

  @@index([adminId])
  @@map("admin_audit_log")
}

/// Privacy-first analytics: named events with anonymous properties only.
model AnalyticsEvent {
  id        BigInt   @id @default(autoincrement())
  name      String
  props     Json?
  createdAt DateTime @default(now())

  @@index([name, createdAt])
  @@map("analytics_events")
}
