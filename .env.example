# Data source for catalog reads: "static" (seed data, no infrastructure
# needed) or "database" (Prisma + Supabase Postgres).
DATA_SOURCE=static

# ---- Photo conversion engines (ADR 012) --------------------------------
# The AI engine is the default; Quick Outline (on-device, ADR 011) is the
# secondary. Client-visible flags need the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_AI_ENABLED=true
NEXT_PUBLIC_LOCAL_ENABLED=true
NEXT_PUBLIC_LOCAL_DEFAULT=false
NEXT_PUBLIC_POLL_INTERVAL_MS=1000

# Server-side AI vendor. "flux" = Black Forest Labs (docs.bfl.ai);
# "mock" = deterministic local stand-in for dev/e2e (no key, no cost).
AI_PROVIDER=flux
BFL_API_KEY=
BFL_MODEL=flux-2-klein-9b
BFL_API_BASE_URL=https://api.us.bfl.ai
BFL_ESTIMATED_COST_USD=0.02
JOB_TIMEOUT_MS=90000
# Daily AI budget per anonymous IP (production spec: 1). AUTH tier is
# reserved until accounts exist.
AI_LIMIT_ANON_PER_DAY=1
AI_LIMIT_AUTH_PER_DAY=3

# CORS allowlist for the Chrome-extension handoff endpoint: comma-separated
# chrome-extension://<id> origins. Empty = no extension origins allowed.
CAMIPRINTS_EXTENSION_ORIGINS=

# Supabase (required only when DATA_SOURCE=database or auth is enabled).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres via Supabase: pooled URL for the app, direct URL for migrations.
DATABASE_URL=
DIRECT_URL=
