# Data source for catalog reads: "static" (seed data, no infrastructure
# needed) or "database" (Prisma + Supabase Postgres).
DATA_SOURCE=static

# Photo-to-coloring-page provider. "local" runs the Sharp/OpenCV pipeline on
# this server; no external AI API is ever called unless a provider is
# explicitly configured.
COLORING_PROVIDER=local

# Supabase (required only when DATA_SOURCE=database or auth is enabled).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres via Supabase: pooled URL for the app, direct URL for migrations.
DATABASE_URL=
DIRECT_URL=
